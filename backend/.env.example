# Database Configuration (Supabase PostgreSQL + pgvector)
# Example: postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./test.db

# Gemini API Key & Model Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Alternative high-capability model: gemini-3.8-flash

# App Environment
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
